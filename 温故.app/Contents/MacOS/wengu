#!/bin/bash
# 温故的图标（桌面、程序坞里点的那个）。温故本体装在「个人文件夹/温故」，这里只负责把它叫起来：
#   已经开着 → 直接打开页面
#   没开     → 在后台启动，页面由温故自己打开；启动时图标在程序坞里跳动
#   没启动成 → 弹窗说明原因，可以改用终端打开看详细信息
# 用完在页面上点「退出温故」。
DIR="${WENGU_HOME:-$HOME/温故}"
URL="${WENGU_URL:-http://127.0.0.1:8737/}"
WAIT="${WENGU_WAIT:-60}"   # 最多等多少个半秒
LOG="$DIR/.cache/启动记录.txt"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.homebrew/bin:$PATH"

# 不走代理：有些梯子会把发给本机的请求也接管
alive() { curl -s --noproxy '*' --max-time 1 "${URL}api/ping" 2>/dev/null | grep -q '"wengu"'; }

notify() {
  osascript - "$1" "$2" >/dev/null 2>&1 <<'OSA'
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
OSA
}

# 弹窗：alert 标题 正文 [按钮…]；输出用户点的按钮
alert() {
  osascript - "$@" 2>/dev/null <<'OSA'
on run argv
  set b to {"好"}
  if (count of argv) > 2 then set b to items 3 thru -1 of argv
  return button returned of (display alert (item 1 of argv) message (item 2 of argv) buttons b default button 1)
end run
OSA
}

if alive; then
  open "$URL"
  exit 0
fi

if [ ! -f "$DIR/wengu.py" ]; then
  alert "找不到温故" "温故应该在「个人文件夹/温故」里，但那里没有。重新运行一次安装命令就好。" >/dev/null
  exit 1
fi

# 还没有运行环境：交给终端版启动器，它会先装好环境，并显示进度
if ! command -v uv >/dev/null 2>&1; then
  open -a Terminal "$DIR/温故.command"
  exit 0
fi

mkdir -p "$DIR/.cache"
cd "$DIR" || exit 1
# 顺手把 yt-dlp 更新到最新（YouTube 经常变）；没网就用现有版本
nohup bash -c 'uv run --quiet -P yt-dlp wengu.py || uv run --quiet --offline wengu.py' </dev/null >"$LOG" 2>&1 &
pid=$!

for ((i = 0; i < WAIT; i++)); do
  alive && exit 0
  kill -0 "$pid" 2>/dev/null || break
  sleep 0.5
done
alive && exit 0

if kill -0 "$pid" 2>/dev/null; then
  notify "温故正在准备" "第一次打开或刚更新过会慢一些，准备好会自动打开页面。"
  exit 0
fi

why="$(grep -v '^[[:space:]=]*$' "$LOG" 2>/dev/null | tail -n 3 | cut -c1-200)"
[ -n "$why" ] || why="没有留下错误信息。"
if [ "$(alert "温故没能打开" "$why" "关闭" "用终端打开")" = "用终端打开" ]; then
  open -a Terminal "$DIR/温故.command"
fi
exit 1
